# Copiar a .env (que está en .gitignore, nunca se sube) o configurar directamente
# como variables de entorno en el proveedor de hosting (ej. Render > Environment).

# Formato: key1:nombre_integracion1,key2:nombre_integracion2
AUTOVALUA_API_KEYS=cambiar-esta-key-en-produccion:Mi integración

# Usuario y contraseña del panel administrativo (Basic Auth).
# Si no se definen, usa el default admin / cambiar-esta-password — cambialo
# antes de exponer el servicio fuera de tu máquina.
ADMIN_USER=admin
ADMIN_PASSWORD=cambiar-esta-password-en-produccion
